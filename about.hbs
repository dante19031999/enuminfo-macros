<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Third Party Licenses</title>
    <style>
        :root {
            --bg-color: #f8f9fa;
            --card-bg: #ffffff;
            --text-main: #212529;
            --text-muted: #6c757d;
            --border-color: #e9ecef;
            --link-color: #0d6efd;
            --code-bg: #f1f3f5;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        }

        @media (prefers-color-scheme: dark) {
            :root {
                --bg-color: #121212;
                --card-bg: #1e1e1e;
                --text-main: #e0e0e0;
                --text-muted: #a0a0a0;
                --border-color: #2d2d2d;
                --link-color: #6ea8fe;
                --code-bg: #161616;
                --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
            }
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.6;
            margin: 0;
            padding: 40px 20px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        .intro {
            text-align: center;
            margin-bottom: 40px;
        }

        .intro h1 {
            font-size: 2.25rem;
            margin-bottom: 8px;
            font-weight: 700;
        }

        .intro p {
            color: var(--text-muted);
            font-size: 1.05rem;
        }

        h2 {
            font-size: 1.5rem;
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 8px;
            margin-top: 36px;
            margin-bottom: 20px;
        }

        a {
            color: var(--link-color);
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }

        /* Licencias resumen */
        .licenses-overview {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            list-style: none;
            padding: 0;
            margin-bottom: 30px;
        }

        .licenses-overview li {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 6px 14px;
            font-size: 0.9rem;
            box-shadow: var(--shadow);
        }

        /* Lista principal de licencias */
        .licenses-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .license-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: var(--shadow);
        }

        .license-card h3 {
            margin-top: 0;
            margin-bottom: 12px;
            font-size: 1.3rem;
            color: var(--link-color);
        }

        .license-card h4 {
            margin-top: 16px;
            margin-bottom: 8px;
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
        }

        .license-used-by {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            list-style: none;
            padding: 0;
            margin: 0 0 16px 0;
        }

        .license-used-by li a {
            display: inline-block;
            background-color: var(--code-bg);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 2px 8px;
            border-radius: 4px;
            font-family: SFMono-Regular, Consolas, "Liberation Mono", Menlo, monospace;
            font-size: 0.85rem;
        }

        .license-used-by li a:hover {
            border-color: var(--link-color);
            color: var(--link-color);
            text-decoration: none;
        }

        /* Texto legal de la licencia */
        .license-text {
            background-color: var(--code-bg);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 16px;
            max-height: 250px;
            overflow-y: auto;
            white-space: pre-wrap;
            font-family: SFMono-Regular, Consolas, "Liberation Mono", Menlo, monospace;
            font-size: 0.825rem;
            line-height: 1.5;
            color: var(--text-muted);
        }
    </style>
</head>

<body>
    <main class="container">
        <div class="intro">
            <h1>Third Party Licenses</h1>
            <p>This page lists the licenses of the dependencies used in this project.</p>
        </div>

        <h2>Overview of licenses</h2>
        <ul class="licenses-overview">
            {{#each overview}}
            <li><a href="#{{id}}">{{name}}</a> <strong>({{count}})</strong></li>
            {{/each}}
        </ul>

        <h2>All license terms</h2>
        <ul class="licenses-list">
            {{#each licenses}}
            <li class="license-card">
                <h3 id="{{id}}">{{name}}</h3>
                <h4>Used by:</h4>
                <ul class="license-used-by">
                    {{#each used_by}}
                    <li>
                        <a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}" target="_blank" rel="noopener">
                            {{crate.name}} v{{crate.version}}
                        </a>
                    </li>
                    {{/each}}
                </ul>
                <pre class="license-text">{{text}}</pre>
            </li>
            {{/each}}
        </ul>
    </main>
</body>

</html>